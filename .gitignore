# Environment and tool caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Large media that can be re-downloaded (data/raw/SOURCES.md) or regenerated
data/raw/**/*.webm
data/raw/**/*.mp4
data/raw/**/*.MP4
data/raw/**/*.mov
data/raw/**/*.MOV
data/raw/**/*.m4v
data/raw/**/*.3gp
data/raw/**/*.mkv
data/raw/**/*.avi
data/raw/**/*.mts
data/raw/**/*.MTS
data/raw/**/*.m2ts
data/synth/*.mp4
out/**/previews/
out/**/preview_*.mp4
out/**/scenes/*.mp4
# Built from what is on disk: the result index and the tag copies by name
out/index.html
out/**/tags.jsonl

# Third-party code (see README) and model weights; only the index
# (models/README.md) and manifests are tracked
third_party/
models/**
!models/*/
!models/README.md
!models/**/*.json

# Internal notes and plans stay local
docs/

# Downloaded datasets and archives
data/downloads/

# A/B evaluation: test material and finished cuts stay local
ab_eval/testset/*
!ab_eval/testset/README.md
ab_eval/results/case-9*/
ab_eval/results/**/*.mp4
ab_eval/results/**/work/

